<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive launcher icon (API 26+). The legacy mipmap-*/ic_launcher.jpg is kept
    for API 24-25 devices. The foreground layer holds the A+ Study House lockup
    sized inside the central safe zone so no launcher mask clips it.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>