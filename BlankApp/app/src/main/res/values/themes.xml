<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        Window theme for the activity shell. The in-app colours come from the
        Compose theme (ui/theme/Color.kt); this only styles what shows before
        Compose draws (splash window, system bars).
    -->
    <style name="Theme.APlusStudyHouse" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/brand_maroon</item>
        <item name="colorPrimaryVariant">@color/brand_maroon_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/brand_maroon_dark</item>
        <item name="colorSecondaryVariant">@color/brand_maroon_dark</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Status bar color -->
        <item name="android:statusBarColor" tools:targetApi="l">@color/brand_maroon_dark</item>
    </style>
</resources>